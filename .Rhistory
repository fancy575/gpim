devtools::document()
devtools::document()
remove.packages(gpim())
remove.packages(gpim)
remove.packages("gpim")
devtools::document()
devtools::document()
devtools::document()
if (!requireNamespace("gpim", quietly = TRUE)) {
stop("The gpim package is not installed in the current R library.")
}
library(gpim)
message("Testing gpim ", packageVersion("gpim"), " from ", find.package("gpim"))
# Both supplied data sets are synthetic.
data("hfaction", package = "gpim")
data("hierarchy", package = "gpim")
stopifnot(is.data.frame(hfaction), nrow(hfaction) > 0L,
is.data.frame(hierarchy), nrow(hierarchy) > 0L)
# Check convergence and finite estimates, standard errors, and inference.
check_fit <- function(object) {
d <- pim_diagnostics(object)
tab <- trajectory_data(object)
stopifnot(inherits(object, "prior_pim"), nrow(d) > 0L,
all(d$converged), all(d$inference_available),
!any(d$requires_attention),
all(is.finite(as.matrix(tab[c("estimate", "std.error",
"p.value", "conf.low", "conf.high")]))),
all(tab$std.error > 0),
all(tab$p.value >= 0 & tab$p.value <= 1),
all(tab$conf.low <= tab$estimate & tab$estimate <= tab$conf.high))
invisible(d)
}
# 1. Fit CH, HT, and DL with a logit link at the three default times.
fit <- gpim(
HierSurv(time, status) ~
treatment + I(age / 10) + sex + I(lvef / 5),
data = hfaction,
id = "id",
method = c("CH", "HT", "DL"),
link = "logit",
censor_formula = ~ treatment + I(age / 10) + sex,
control = pim_control(maxit = 100L, tol = 1e-8, on_failure = "stop")
)
diagnostics <- check_fit(fit)
terminal_time <- hfaction$time[hfaction$status %in% c(0, 1)]
expected_L <- unname(quantile(terminal_time, c(0.25, 0.50, 0.75)))
stopifnot(nobs(fit) == length(unique(hfaction$id)), nrow(diagnostics) == 9L,
isTRUE(all.equal(fit$L, expected_L)))
# 2. Display DL estimates, SEs, confidence intervals, and p-values.
fit_summary <- summary(fit, method = "DL")
print(fit_summary)
print(diagnostics[c("L", "method", "link", "converged",
"inference_available")], row.names = FALSE)
# Extract one fitted model and check its coefficient and covariance methods.
middle_L <- fit$L[2]
b <- coef(fit, method = "DL", L = middle_L)
V <- vcov(fit, method = "DL", L = middle_L)
ci <- confint(fit, method = "DL", L = middle_L)
stopifnot(length(b) == 4L, all(is.finite(b)),
all(dim(V) == c(4L, 4L)), all(is.finite(V)), all(diag(V) > 0),
all(dim(ci) == c(4L, 2L)), all(is.finite(ci)))
# 3. Check all three links with a simple treatment model at one specified L.
fit_links <- gpim(
HierSurv(time, status) ~ treatment,
data = hfaction,
L = middle_L,
method = c("CH", "HT", "DL"),
link = c("identity", "logit", "probit"),
censor_formula = ~ treatment + I(age / 10) + sex,
control = pim_control(on_failure = "stop")
)
link_diagnostics <- check_fit(fit_links)
stopifnot(nrow(link_diagnostics) == 9L)
# 4. Test plotting and save the resulting panels. Also show DL plots in RStudio.
pdf_file <- file.path(getwd(), "gpim_test_plots.pdf")
local({
grDevices::pdf(pdf_file, width = 8, height = 6)
on.exit(grDevices::dev.off())
plot(fit, method = "DL")
plot(fit, parameters = "treatmentExercise", conf.int = FALSE)
})
stopifnot(file.exists(pdf_file), file.info(pdf_file)$size > 0)
if (interactive()) plot(fit, method = "DL")
message("PASS: all 18 fitted models converged and passed the inference checks.")
message("Summaries, extraction methods, and plotting passed.")
message("Plots: ", normalizePath(pdf_file, winslash = "/"))
devtools::document()
devtools::document()
remove.packages("gpim")
